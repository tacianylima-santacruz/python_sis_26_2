{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPSAadqoMH1dZocoMiJHD77"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["Atividade 01\n","--------------------------------------------------------------------------------------"],"metadata":{"id":"3rz7GwLOQast"}},{"cell_type":"code","source":["# =====================================================\n","# GENE HBB - Tradução de DNA em Aminoácidos\n","# =====================================================\n","\n","# --- PROCESSAMENTO 1: Entrada e Comparação ---\n","\n","# Solicita ao usuário a fita de DNA\n","fita_usuario = input(\"Digite uma fita de DNA com 21 nucleotídeos: \")\n","\n","# Padroniza para maiúsculas\n","fita_usuario = fita_usuario.upper()\n","\n","# Exibe a fita formatada usando f-string\n","print(f\"\\nFita digitada: {fita_usuario}\")\n","\n","# Sequência de referência normal (Hemoglobina A)\n","referencia = \"ATGGTGCACCTGACTCCTGAG\"\n","\n","# Compara a fita digitada com a referência (True = mutante, False = normal)\n","mutante = fita_usuario != referencia\n","\n","# Lista de diagnósticos (índice 0 = False/normal, índice 1 = True/mutante)\n","diagnosticos = [\"✅ Sequência NORMAL (Hemoglobina A)\", \"⚠️ Sequência MUTANTE (Anemia Falciforme - HbS)\"]\n","\n","# Exibe o diagnóstico acessando a lista pelo índice booleano (sem if)\n","print(f\"Diagnóstico: {diagnosticos[mutante]}\")\n","\n","\n","# --- PROCESSAMENTO 2: Tradução de Códons ---\n","\n","# Aplica .replace() sucessivos para traduzir cada códon em seu aminoácido\n","proteina = fita_usuario.replace(\"ATG\", \"Met-\").replace(\"GTG\", \"Val-\").replace(\"CAC\", \"His-\").replace(\"CTG\", \"Leu-\").replace(\"ACT\", \"Thr-\").replace(\"CCT\", \"Pro-\").replace(\"GAG\", \"Glu\")\n","\n","print(f\"Proteína traduzida: {proteina}\")\n","\n","\n","# --- PROCESSAMENTO 3: Busca de Aminoácido ---\n","\n","# Solicita ao usuário um aminoácido para buscar na proteína\n","aminoacido_busca = input(\"\\nDigite um aminoácido para buscar (ex: Val ou His): \")\n","\n","# Localiza o índice do aminoácido na proteína traduzida\n","posicao = proteina.find(aminoacido_busca)\n","\n","# --- Relatório Final ---\n","print(f\"\"\"\n","================ RELATÓRIO FINAL ================\n","DNA de referência : {referencia}\n","DNA digitado       : {fita_usuario}\n","Tamanho da fita     : {len(fita_usuario)}\n","Proteína traduzida : {proteina}\n","Diagnóstico         : {diagnosticos[mutante]}\n","Posição de \"{aminoacido_busca}\" na proteína : {posicao}\n","===================================================\n","\"\"\")"],"metadata":{"id":"WYfduK9K3J3g"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Atividade 02\n","--------------------------------------------------------------------------------------"],"metadata":{"id":"6I3mHPXSQd9U"}},{"cell_type":"code","source":["# =====================================================\n","# O ANALISADOR DE PERGAMINHOS DA TERRA-MÉDIA\n","# =====================================================\n","\n","# --- ENTRADA DE DADOS ---\n","\n","# Solicita ao usuário o texto do pergaminho (pode vir com espaços extras)\n","pergaminho_bruto = input(\"Digite o texto do pergaminho: \")\n","\n","# Exibe o texto exatamente como foi digitado, para comparação\n","print(f\"\\nTexto digitado (bruto): '{pergaminho_bruto}'\")\n","\n","\n","# --- LIMPEZA E HIGIENIZAÇÃO ---\n","\n","# Remove os espaços inúteis do início e do fim do texto\n","pergaminho_limpo = pergaminho_bruto.strip()\n","\n","print(f\"Texto higienizado: '{pergaminho_limpo}'\")\n","\n","\n","# --- PROCESSAMENTO: Divisão em palavras ---\n","\n","# Separa o texto limpo em uma lista de palavras\n","palavras = pergaminho_limpo.split()\n","\n","# Número total de caracteres do texto limpo\n","total_caracteres = len(pergaminho_limpo)\n","\n","# Quantidade total de palavras\n","total_palavras = len(palavras)\n","\n","# Primeira e última palavra do texto\n","primeira_palavra = palavras[0]\n","ultima_palavra = palavras[-1]\n","\n","\n","# --- DETECTOR DE AMEAÇAS ---\n","\n","# Palavra a ser procurada no pergaminho\n","palavra_procurada = \"Anel\"\n","\n","# Verifica se a palavra existe no texto (True/False)\n","palavra_existe = palavra_procurada in pergaminho_limpo\n","\n","# Lista de resultados (índice 0 = False, índice 1 = True)\n","resultados_ameaca = [\"🟢 Nenhuma menção encontrada.\", \"🔴 Ameaça detectada no pergaminho!\"]\n","\n","# Conta quantas vezes a palavra aparece no texto\n","quantidade_ameaca = pergaminho_limpo.count(palavra_procurada)\n","\n","\n","# --- RELATÓRIO FINAL ---\n","print(f\"\"\"\n","================ RELATÓRIO DO PERGAMINHO ================\n","Texto higienizado          : {pergaminho_limpo}\n","Total de caracteres         : {total_caracteres}\n","Total de palavras           : {total_palavras}\n","Primeira palavra            : {primeira_palavra}\n","Última palavra               : {ultima_palavra}\n","Palavra procurada            : \"{palavra_procurada}\"\n","Detector de ameaças          : {resultados_ameaca[palavra_existe]}\n","Ocorrências de \"{palavra_procurada}\"      : {quantidade_ameaca}\n","===========================================================\n","\"\"\")"],"metadata":{"id":"WAb4E5MaSGAV"},"execution_count":null,"outputs":[]}]}